{
    "name": "sheet-project",
    "version": "1.0.0",
    "scripts": {
        "install:all": "npm install && cd server && npm install && cd ../my-react-app && npm install",
        "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
        "dev:server": "cd server && npm start",
        "dev:client": "cd my-react-app && npm run dev"
    },
    "devDependencies": {
        "concurrently": "^8.2.2"
    }
}